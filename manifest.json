{
  "manifest_version": 3,
  "name": "English CC for Twitch via OBS",
  "description": "Transcribe Japanese speech, translate it to English in Chrome, and send it to Twitch as OBS closed captions.",
  "version": "0.1.0",
  "minimum_chrome_version": "138",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "English CC"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:*;"
  }
}
